# 本機 Node 開發模式維持原本 cookie／展示流程，不讀取這兩個設定。
# ChatGPT Sites Worker 以 oai-authenticated-user-id 比對逗號分隔的清單。
# 請在 Sites 的 server-side environment variables 設定實際值，不要提交真實 ID。
LUNCH_ADMIN_IDS=chatgpt-user-id-for-admin
LUNCH_MEMBER_IDS=chatgpt-user-id-for-member-1,chatgpt-user-id-for-member-2

# 僅本機 Node 展示用；Sites 模式禁止管理碼認領。
DEMO_KEY=demo
